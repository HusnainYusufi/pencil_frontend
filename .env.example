# Pencil web app (server-side only; never exposed to the browser)

# Pencil API base URL, including the version prefix.
PENCIL_API_URL=http://localhost:4100/api/v1

# Encrypts the session cookie (iron-session). At least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars

# Sign out after this many minutes without activity.
SESSION_IDLE_MINUTES=60

# Secure cookies (__Host- prefix). Defaults to true in production and must stay true there.
# Browsers treat http://localhost as secure, so local production builds work with it on.
# COOKIE_SECURE=false

# local | staging | production (non-production shows a banner).
PENCIL_ENVIRONMENT=local
